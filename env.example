# ─── Groq API ────────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Local:    postgresql://postgres:password@localhost:5432/ai_assistant
# Azure:    postgresql://adminuser:password@myserver.postgres.database.azure.com:5432/postgres?sslmode=require
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ai_assistant

# PostgreSQL Connection Details (used by setup_database.py)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=postgres
POSTGRES_ADMIN_DB=postgres

# SSL mode: "prefer" for local, "require" for Azure / Supabase / any cloud DB
POSTGRES_SSL=prefer

# ─── LangSmith Observability (free tier: 5,000 traces/month) ─────────────────
# Sign up at: https://smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=memos
